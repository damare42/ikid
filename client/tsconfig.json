{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // @engine reaches the server's *pure* calculation modules — finmath, tax,
    // retirement, debtPayoff, billsCore, reconcileCore and friends. The hosted
    // demo runs them in the browser so it computes with the same code the
    // server does. Only import files from there that have no Prisma import;
    // anything that touches the database will fail at runtime in a browser.
    "paths": {
      "@shared/*": ["../shared/*"],
      "@engine/*": ["../server/src/services/*"],
      "@demo": ["./src/demo/index.ts"]
    }
  },
  "include": ["src", "../shared"]
}
