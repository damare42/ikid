{
  "$comment": "Ikid redesign tokens. 'base' = the Modernist design system; 'app' = deliberate overrides the app ships with. Where a key appears in both, the app value wins. Generate CSS variables / theme config from this file.",
  "font": {
    "heading": "\"Archivo\", system-ui, sans-serif",
    "body": "\"Archivo\", system-ui, sans-serif",
    "headingWeight": 800,
    "weightsNeeded": [400, 600, 700, 800]
  },
  "radius": {
    "$rule": "0 on all structure; 9px ONLY on interactive chrome",
    "structure": "0px",
    "button": "9px",
    "iconButton": "9px",
    "avatar": "9px",
    "bubble": "14px"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px" },
  "shadow": {
    "sm": "0 1px 2px color-mix(in srgb, #2d2b2b 14%, transparent)",
    "md": "0 3px 10px color-mix(in srgb, #2d2b2b 16%, transparent)",
    "lg": "0 12px 32px color-mix(in srgb, #2d2b2b 22%, transparent)",
    "$usedBy": { "lg": ["avatar menu", "import dialog"], "sm": [], "md": [] }
  },
  "color": {
    "light": {
      "bg": "#f3f2f2",
      "panel": "#ffffff",
      "surface": "#eae9e9",
      "text": "#201e1d",
      "divider": "rgba(32,30,29,0.4)",
      "accent": "#c62f14",
      "accentHover": "#a82710",
      "accentPressed": "#8a1f0c",
      "accentTextSafe": "#8a1f0c",
      "accent100": "#fff2ef",
      "poster": "#a3260f",
      "pos": "#1a7f5a",
      "neg": "#c62f14",
      "warn": "#9a6a10",
      "pos100": "color-mix(in srgb, #1a7f5a 16%, transparent)",
      "neutral": {
        "100": "#f8f4f4", "200": "#eae7e7", "300": "#d7d3d3", "400": "#bab6b6",
        "500": "#9b9797", "600": "#7d7979", "700": "#605d5d", "800": "#444141", "900": "#2d2b2b"
      }
    },
    "dark": {
      "bg": "#161514",
      "panel": "#201e1d",
      "surface": "#252322",
      "text": "#f3f2f2",
      "divider": "color-mix(in srgb, #f3f2f2 26%, transparent)",
      "accent": "#ff7a5e",
      "accentHover": "#ff9783",
      "accentPressed": "#ffb5a3",
      "accentTextSafe": "#ffb5a3",
      "accent100": "color-mix(in srgb, #ff7a5e 20%, #201e1d)",
      "pos": "#5fd3a3",
      "neg": "#ff7a5e",
      "warn": "#e0ad55",
      "pos100": "color-mix(in srgb, #5fd3a3 20%, #201e1d)",
      "primaryButtonText": "#201e1d",
      "neutral": {
        "100": "#252322", "200": "#302d2c", "300": "#413d3c", "400": "#5c5857",
        "500": "#8a8685", "600": "#a7a3a2", "700": "#c4c0bf", "800": "#ded9d8", "900": "#f3f2f2"
      }
    }
  },
  "category": {
    "$note": "Chart and budget-bar colors. Always paired with a text label — never the only signal.",
    "groceries":     { "light": "#5b7d3f", "dark": "#9fc47c" },
    "dining":        { "light": "#c0632c", "dark": "#f0a274" },
    "transport":     { "light": "#3d6d8f", "dark": "#84b4d6" },
    "housing":       { "light": "#7a5a86", "dark": "#bda6cd" },
    "subscriptions": { "light": "#8a6b2f", "dark": "#d4b071" },
    "utilities":     { "light": "#3f7d76", "dark": "#7fc7bd" },
    "shopping":      { "light": "#a34f6a", "dark": "#e293aa" },
    "income":        { "light": "#1a7f5a", "dark": "#5fd3a3" }
  },
  "type": {
    "pageTitle":    { "font": "heading", "weight": 800, "size": "clamp(32px,4vw,54px)", "letterSpacing": "-0.03em", "lineHeight": 1 },
    "heroFigure":   { "font": "heading", "weight": 800, "size": "clamp(38px,6.4vw,82px)", "letterSpacing": "-0.03em", "lineHeight": 1 },
    "statFigure":   { "font": "heading", "weight": 800, "size": "clamp(20px,2.4vw,34px)", "letterSpacing": "-0.02em", "lineHeight": 1 },
    "sectionTitle": { "font": "heading", "weight": 800, "size": "16px", "letterSpacing": "-0.01em" },
    "kicker":       { "font": "heading", "weight": 600, "size": "10px", "letterSpacing": "0.14em", "textTransform": "uppercase", "color": "neutral.600", "$floor": "10px — never smaller" },
    "body":         { "font": "body", "weight": 400, "size": "15-16px", "lineHeight": 1.6, "color": "neutral.700", "textWrap": "pretty" },
    "table":        { "size": "13px", "dense": "12px", "numerals": "tabular-nums" },
    "nav":          { "font": "heading", "weight": 600, "size": "13px" },
    "mono":         { "family": "ui-monospace, SFMono-Regular, Menlo, monospace", "size": "12px", "mobile": "11px", "$usedBy": "error technical detail only" }
  },
  "layout": {
    "wrapMaxWidth": "1200px",
    "wrapPaddingX": { "desktop": "32px", "tablet": "20px" },
    "railWidth": "222px",
    "headerPaddingY": "16px",
    "headerHeight": "~64px",
    "narrowScreenMaxWidth": { "planner": "860px", "settings": "900px", "stateScreens": "820px" },
    "breakpoints": {
      "desktop": ">=1101px",
      "tablet": "701-1100px",
      "mobile": "<=700px",
      "$note": "Prototype implements these as container queries on the app root so the Frame switch can preview them; use media queries in production."
    },
    "responsiveGridClasses": {
      "g-1up-tablet": "collapse to 1 column at tablet (dashboard 3-up section, accounts rows)",
      "g-3up": "3-up -> 2-up at tablet, 1-up at <=780px",
      "g-2up": "2-up -> 1-up at <=780px",
      "g-acctrow": "accounts 5-column row -> 1 column at tablet",
      "g-budgetrow": "budget row -> name / full-width bar / spent+forecast+delete at tablet"
    }
  },
  "motion": {
    "buttons": "background .15s ease, box-shadow .15s ease",
    "chevron": "transform .15s ease",
    "skeletonPulse": "opacity 1 -> 0.38 -> 1, 1.5s ease-in-out infinite, stagger .12s per row",
    "$note": "Nothing else animates. The boot splash is prototype-only."
  },
  "focus": { "outline": "2px solid accent", "outlineOffset": "2px", "$rule": ":focus-visible on every interactive element; never the browser default" },
  "hitTarget": { "min": "44px", "$appliesTo": ["mobile tab bar", "mobile quick actions"] },
  "icons": { "set": "Lucide", "size": "18-20px desktop, 22-23px mobile", "strokeWidth": 2, "color": "currentColor" },
  "states": {
    "screensWithStates": ["dashboard", "transactions", "accounts", "budgets", "goals", "networth", "analytics", "reports"],
    "screensWithoutStates": { "list": ["planner", "calculators", "retirement", "settings", "admin"], "why": "input-driven — they compute from form values, not stored rows" },
    "loading": { "skeletonFill": "neutral.200", "showAfterMs": 150, "ariaBusy": true, "shapes": { "cards": ["dashboard"], "table": ["transactions", "accounts", "networth", "reports"], "bars": ["budgets", "goals"], "chart": ["analytics"] } },
    "error": { "role": "alert", "device": "2px accent left rule, 24px padding-left (18px for partial, 16px mobile)", "$rule": "every body says whether anything was written; Try again always re-enters loading" },
    "partial": { "$rule": "scope the failure to the section; two or more failed sections on one screen falls back to the full-page error" }
  }
}
